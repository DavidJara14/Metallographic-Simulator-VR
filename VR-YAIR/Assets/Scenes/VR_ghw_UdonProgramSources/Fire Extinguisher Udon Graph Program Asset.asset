  udonAssembly: ".data_start\r\n\r\n    .export PartSyst\r\n    .export PartycleSystemComp\r\n   
    \r\n    __instance_0: %VRCUdonUdonBehaviour, this\r\n    __target_0: %VRCUdonCommonInterfacesNetworkEventTarget,
    null\r\n    __eventName_0: %SystemString, null\r\n    __instance_1: %VRCUdonUdonBehaviour,
    this\r\n    __target_1: %VRCUdonCommonInterfacesNetworkEventTarget, null\r\n   
    __eventName_1: %SystemString, null\r\n    __Boolean_0: %SystemBoolean, null\r\n   
    __instance_2: %UnityEngineParticleSystem, null\r\n    __instance_3: %UnityEngineParticleSystem,
    null\r\n    __instance_4: %UnityEngineParticleSystem, null\r\n    __instance_5:
    %UnityEngineParticleSystem, null\r\n    PartSyst: %UnityEngineGameObject, this\r\n   
    PartycleSystemComp: %UnityEngineParticleSystem, null\r\n\r\n.data_end\r\n\r\n.code_start\r\n\r\n   
    .export _onPickupUseDown\r\n    \r\n    _onPickupUseDown:\r\n    \r\n       
    PUSH, __instance_0\r\n        PUSH, __target_0\r\n        PUSH, __eventName_0\r\n       
    EXTERN, \"VRCUdonCommonInterfacesIUdonEventReceiver.__SendCustomNetworkEvent__VRCUdonCommonInterfacesNetworkEventTarget_SystemString__SystemVoid\"\r\n       
    JUMP, 0xFFFFFFFC\r\n    \r\n    .export _onDrop\r\n    \r\n    _onDrop:\r\n   
    \r\n        PUSH, __instance_1\r\n        PUSH, __target_1\r\n        PUSH, __eventName_1\r\n       
    EXTERN, \"VRCUdonCommonInterfacesIUdonEventReceiver.__SendCustomNetworkEvent__VRCUdonCommonInterfacesNetworkEventTarget_SystemString__SystemVoid\"\r\n       
    JUMP, 0xFFFFFFFC\r\n    \r\n    .export UseThisThing\r\n    \r\n    UseThisThing:\r\n   
    \r\n        PUSH, PartycleSystemComp\r\n        PUSH, __instance_2\r\n       
    COPY\r\n        PUSH, __instance_2\r\n        PUSH, __Boolean_0\r\n        EXTERN,
    \"UnityEngineParticleSystem.__get_isEmitting__SystemBoolean\"\r\n        PUSH,
    __Boolean_0\r\n        JUMP_IF_FALSE, 0x000000B8\r\n        PUSH, PartycleSystemComp\r\n       
    PUSH, __instance_3\r\n        COPY\r\n        PUSH, __instance_3\r\n        EXTERN,
    \"UnityEngineParticleSystem.__Stop__SystemVoid\"\r\n        JUMP, 0x000000DC\r\n       
    PUSH, PartycleSystemComp\r\n        PUSH, __instance_4\r\n        COPY\r\n       
    PUSH, __instance_4\r\n        EXTERN, \"UnityEngineParticleSystem.__Play__SystemVoid\"\r\n       
    JUMP, 0xFFFFFFFC\r\n    \r\n    .export Deactivate\r\n    \r\n    Deactivate:\r\n   
    \r\n        PUSH, PartycleSystemComp\r\n        PUSH, __instance_5\r\n       
    COPY\r\n        PUSH, __instance_5\r\n        EXTERN, \"UnityEngineParticleSystem.__Stop__SystemVoid\"\r\n       
    JUMP, 0xFFFFFFFC\r\n    \r\n\r\n.code_end\r\n"

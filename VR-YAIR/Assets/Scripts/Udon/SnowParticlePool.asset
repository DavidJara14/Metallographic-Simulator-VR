  udonAssembly: ".data_start\r\n\r\n    .export Pool\r\n    \r\n    __GameObject_0:
    %UnityEngineGameObject, this\r\n    __Boolean_0: %SystemBoolean, null\r\n   
    __instance_1: %UnityEngineGameObject, this\r\n    __other_0: %SystemObject, null\r\n   
    __instance_0: %VRCSDK3ComponentsVRCObjectPool, null\r\n    __var_0: %SystemObject,
    null\r\n    Pool: %VRCSDK3ComponentsVRCObjectPool, null\r\n    __returnValue:
    %SystemObject, null\r\n\r\n.data_end\r\n\r\n.code_start\r\n\r\n    .export _onPlayerJoined\r\n   
    \r\n    _onPlayerJoined:\r\n    \r\n        PUSH, Pool\r\n        PUSH, __instance_0\r\n       
    COPY\r\n        PUSH, __instance_0\r\n        PUSH, __GameObject_0\r\n       
    EXTERN, \"VRCSDK3ComponentsVRCObjectPool.__TryToSpawn__UnityEngineGameObject\"\r\n       
    PUSH, Pool\r\n        PUSH, __instance_0\r\n        COPY\r\n        PUSH, __GameObject_0\r\n       
    PUSH, __instance_1\r\n        COPY\r\n        PUSH, __var_0\r\n        PUSH,
    __other_0\r\n        COPY\r\n        PUSH, __GameObject_0\r\n        PUSH, __other_0\r\n       
    PUSH, __Boolean_0\r\n        EXTERN, \"UnityEngineGameObject.__Equals__SystemObject__SystemBoolean\"\r\n       
    PUSH, __Boolean_0\r\n        JUMP_IF_FALSE, 0x00000098\r\n        JUMP, 0xFFFFFFFC\r\n   
    \r\n\r\n.code_end\r\n"
